# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# production mode 后台请求地址（H5 走 nginx 代理，填相对路径）
VITE_SERVER_BASEURL = '/admin-api'
# 原生 App 无网页同源地址，需要使用可从手机访问的完整接口地址
VITE_SERVER_BASEURL__APP = 'https://cms.accurantbio.com:64234/admin-api'
VITE_APP_PUBLIC_BASE = '/h5/'
